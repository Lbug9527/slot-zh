+fn pct_step(percent: u8, right: bool) -> u8 {
+    let steps = [5u8, 10, 15, 20, 25, 30];
+    let at = steps
+        .iter()
+        .position(|&v| v >= percent)
+        .unwrap_or(steps.len() - 1);
+    if right {
+        steps[(at + 1) % steps.len()]
+    } else {
+        steps[(at + steps.len() - 1) % steps.len()]
+    }
+}
