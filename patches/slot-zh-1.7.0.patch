+fn sync_cart_backdrop(app: &mut App, compositor: &mut Compositor, state: &mut CartBgSync) {
+    let (key, source): (Option<String>, Option<BackdropJob>) = match app.phase() {
+        Phase::Shelf => match app.selected_cart() {
+            Some(cart) => {
+                let source = match label_for(cart) {
+                    Some(path) => BackdropJob::Label(path),
+                    None => BackdropJob::Face(Box::new(cart.clone())),
+                };
+                (Some(cart.rom.to_string_lossy().into_owned()), Some(source))
+            }
+            None => (None, None),
+        },
+        _ => (None, None),
+    };
+    if state.key != key {
+        state.key = key;
+        state.pending = None;
+        match source {
+            Some(source) => {
+                let cache_key = match &source {
+                    BackdropJob::Label(path) => path.clone(),
+                    BackdropJob::Face(cart) => cart.rom.clone(),
+                };
+                if let Some(hit) = state.cache.get(&cache_key) {
+                    let rgba = hit.clone();
+                    paint_backdrop(app, compositor, state, &rgba);
+                } else if backdrop_worker()
+                    .0
+                    .send((cache_key.clone(), source))
+                    .is_ok()
+                {
+                    state.pending = Some(cache_key);
+                }
+            }
+            None => {
+                let prev = state.slots[state.cur];
+                app.set_cart_backdrop(None, prev, Some(CART_BG_FADE_MS));
+            }
+        }
+    }
+    // Collect anything the worker finished since the last frame.
+    let worker = backdrop_worker();
+    let mut done = Vec::new();
+    while let Ok(item) = worker.1.try_recv() {
+        done.push(item);
+    }
+    drop(worker);
+    for (path, rgba) in done {
+        if state.cache.len() >= 12 {
+            state.cache.clear();
+        }
+        state.cache.insert(path.clone(), rgba.clone());
+        if state.pending.as_deref() == Some(path.as_path()) {
+            state.pending = None;
+            paint_backdrop(app, compositor, state, &rgba);
+        }
+    }
+}
