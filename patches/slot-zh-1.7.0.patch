+/// The label art for a cart. Labels follow the card's own naming, which often
+/// differs from the ROM file name (`(patched)`, tags, romanisation), so an exact
+/// hit is tried first and then a normalised substring match picks the closest.
+fn label_for(cart: &slot_store::Cart) -> Option<std::path::PathBuf> {
+    if let Some(label) = &cart.label {
+        return Some(label.clone());
+    }
+    let root = cart.rom.parent()?.parent()?.parent()?;
+    let labels = root.join("Labels").join(cart.platform.dir_name());
+    let want = core_key(&cart.stem);
+    if want.is_empty() {
+        return None;
+    }
+    let want_chars: std::collections::HashSet<char> = want.chars().collect();
+    let mut best: Option<(f32, usize, std::path::PathBuf)> = None;
+    for entry in std::fs::read_dir(&labels).ok()?.flatten() {
+        let name = entry.file_name().to_string_lossy().into_owned();
+        let stem = match name.to_lowercase().strip_suffix(".png") {
+            Some(stem) => stem.to_string(),
+            None => continue,
+        };
+        // Cover sets are named after the original ROM stem, so once the noise
+        // (bracket tags, `(patched)`, version strings) is stripped an exact
+        // match is the strongest signal and needs no fuzzy scoring.
+        let candidate = core_key(&stem);
+        if candidate.is_empty() {
+            continue;
+        }
+        if candidate == want {
+            return Some(entry.path());
+        }
+        let chars: std::collections::HashSet<char> = candidate.chars().collect();
+        let hit = chars.iter().filter(|c| want_chars.contains(c)).count();
+        let ratio = hit as f32 / chars.len() as f32;
+        if hit < 2 || ratio < 0.6 {
+            continue;
+        }
+        let better = match &best {
+            None => true,
+            Some((top, len, _)) => {
+                ratio > *top + 0.001 || ((ratio - *top).abs() < 0.001 && chars.len() > *len)
+            }
+        };
+        if better {
+            best = Some((ratio, chars.len(), entry.path()));
+        }
+    }
+    best.map(|(_, _, path)| path)
+}
+
+fn normalise(text: &str) -> String {
+    text.chars()
+        .filter(|c| c.is_alphanumeric())
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+/// Matching key for a ROM/label name: bracket groups (`(US)`, `（中文版）`,
+/// `[...]`), version strings and patch markers are dropped, everything else is
+/// lowercased and reduced to alphanumerics. Cover sets in the wild are named
+/// after the original ROM stem, so stripping the same noise from both sides
+/// turns most lookups into an exact match.
+fn core_key(text: &str) -> String {
+    let mut out = String::new();
+    let mut depth = 0i32;
+    for c in text.chars() {
+        match c {
+            '(' | '[' | '（' | '【' => depth += 1,
+            ')' | ']' | '）' | '】' => depth = (depth - 1).max(0),
+            _ if depth == 0 => out.push(c),
+            _ => {}
+        }
+    }
+    let mut cleaned = out.to_lowercase();
+    for tag in [
+        "(patched)",
+        "patched",
+        "ver1.00",
+        "ver 1.0",
+        "中文版",
+        "汉化版",
+        "简中",
+        "汉化",
+        "-cn",
+        "_cn",
+    ] {
+        cleaned = cleaned.replace(tag, " ");
+    }
+    cleaned.chars().filter(|c| c.is_alphanumeric()).collect()
+}
