+            match rx.try_recv() {
+                Ok(Ok(status)) => {
+                    eprintln!("slot: wifi: auto connected {} {}", status.ssid, status.ip);
+                    self.wifi_status = Some(status);
+                }
+                Ok(Err(why)) => eprintln!("slot: wifi: auto connect failed: {why}"),
+                Err(std::sync::mpsc::TryRecvError::Empty) => self.wifi_auto = Some(rx),
+                Err(std::sync::mpsc::TryRecvError::Disconnected) => {}
+            }
+        }
+        let Some(rx) = &self.wifi_net else {
+            return;
+        };
+        match rx.try_recv() {
+            Ok(Ok(status)) => {
+                eprintln!("slot: wifi: connected {} {}", status.ssid, status.ip);
+                if let Some(page) = &mut self.wifi {
+                    page.busy = false;
+                    page.status = format!("已连接 {} ({})", status.ssid, status.ip);
+                    page.dirty = true;
+                }
+                self.wifi_status = Some(status);
+                self.wifi_net = None;
+            }
+            Ok(Err(why)) => {
+                eprintln!("slot: wifi: {why}");
+                if let Some(page) = &mut self.wifi {
+                    page.busy = false;
+                    page.status = format!("连接失败：{why}");
+                    page.dirty = true;
+                }
+                self.wifi_net = None;
+            }
+            Err(std::sync::mpsc::TryRecvError::Empty) => {}
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => {
+                self.wifi_net = None;
+            }
+        }
+    }
