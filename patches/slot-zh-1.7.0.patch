+    fn start_wifi_join(&mut self) {
+        if self.wifi_net.is_some() {
+            return;
+        }
+        let Some(root) = self.root().map(Path::to_path_buf) else {
+            return;
+        };
+        let Some(page) = &mut self.wifi else {
+            return;
+        };
+        let ssid = page.ssid.trim().to_string();
+        if ssid.is_empty() {
+            page.status = "请先填写 SSID".to_string();
+            return;
+        }
+        let creds = crate::net::Credentials {
+            ssid,
+            psk: page.psk.clone(),
+        };
+        page.busy = true;
+        page.status = "正在连接…".to_string();
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = std::thread::Builder::new()
+            .name("slot-wifi".to_string())
+            .spawn(move || {
+                let result = crate::net::join(&root, &creds, std::time::Duration::from_secs(30))
+                    .map_err(|e| e.to_string());
+                let _ = tx.send(result);
+            });
+        self.wifi_net = Some(rx);
+    }
