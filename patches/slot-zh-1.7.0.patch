+            return;
+        }
+        if let Some(page) = &mut self.wifi {
+            page.scanning = true;
+            page.status = "正在扫描…".to_string();
+            page.dirty = true;
+        }
+        let (tx, rx) = std::sync::mpsc::channel();
+        self.wifi_scan = Some(rx);
+        let _ = std::thread::Builder::new()
+            .name("slot-wifi-scan".to_string())
+            .spawn(move || {
+                let result = match std::env::var("SLOT_WIFI_FAKE") {
+                    Ok(list) => Ok(list
+                        .split(',')
+                        .map(|s| s.trim().to_string())
+                        .filter(|s| !s.is_empty())
+                        .collect()),
+                    Err(_) => crate::net::scan(std::time::Duration::from_secs(12))
+                        .map_err(|e| e.to_string()),
+                };
+                let _ = tx.send(result);
+            });
+    }
