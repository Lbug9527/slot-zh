+    fn cycle_font(&mut self, right: bool) {
+        if self.fonts.len() < 2 {
+            return;
+        }
+        let len = self.fonts.len();
+        self.font_pick = if right {
+            (self.font_pick + 1) % len
+        } else {
+            (self.font_pick + len - 1) % len
+        };
+        self.hud.toast(Toast::FontSaved, self.now());
+        if let Some(root) = self.root.clone() {
+            let dir = root.join("Config");
+            let _ = std::fs::create_dir_all(&dir);
+            let _ = std::fs::write(dir.join("font.txt"), self.font_key());
+        }
+        eprintln!("slot: font pick: {}", self.font_label());
