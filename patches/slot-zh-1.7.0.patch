+/// The blurred label art used as the shelf backdrop for the selected cart.
+#[derive(Default)]
+struct CartBgSync {
+    key: Option<String>,
+    /// Two textures, alternating, so the outgoing backdrop can fade out while
+    /// the incoming one fades in.
+    slots: [Option<TexId>; 2],
+    cur: usize,
+    /// Blurred backdrops already painted, so revisiting a cart is instant.
+    cache: std::collections::HashMap<std::path::PathBuf, Vec<u8>>,
+    /// The cart whose backdrop is being painted off-thread right now.
+    pending: Option<std::path::PathBuf>,
+}
+
+enum BackdropJob {
+    /// Blur a label image from `Labels/<platform>/`.
+    Label(std::path::PathBuf),
+    /// No cover art for this game: derive a backdrop from the cartridge face
+    /// itself, so every cartridge still gets its own background.
+    Face(Box<slot_store::Cart>),
+}
+
+type BackdropJobs = std::sync::mpsc::Sender<(std::path::PathBuf, BackdropJob)>;
+type BackdropDone = std::sync::mpsc::Receiver<(std::path::PathBuf, Vec<u8>)>;
+
+/// Painting a backdrop means decoding a PNG, resizing it and blurring it, which
+/// is long enough to drop a frame. Keep one worker thread doing that work and
+/// only touch the GPU when the bytes come back.
+fn backdrop_worker() -> std::sync::MutexGuard<'static, (BackdropJobs, BackdropDone)> {
+    static W: std::sync::OnceLock<std::sync::Mutex<(BackdropJobs, BackdropDone)>> =
+        std::sync::OnceLock::new();
+    W.get_or_init(|| {
+        let (job_tx, job_rx) = std::sync::mpsc::channel::<(std::path::PathBuf, BackdropJob)>();
+        let (res_tx, res_rx) = std::sync::mpsc::channel::<(std::path::PathBuf, Vec<u8>)>();
+        std::thread::Builder::new()
+            .name("slot-backdrop".into())
+            .spawn(move || {
+                while let Ok(mut job) = job_rx.recv() {
+                    // Only the newest selection matters.
+                    while let Ok(newer) = job_rx.try_recv() {
+                        job = newer;
+                    }
+                    let (key, source) = job;
+                    let face = match &source {
+                        BackdropJob::Label(path) => wallpaper_face(path),
+                        BackdropJob::Face(cart) => Some(face_backdrop(cart)),
+                    };
+                    if let Some(face) = face {
+                        let mut rgba = blur_face(&face);
+                        if matches!(source, BackdropJob::Face(_)) {
+                            // A blurred cartridge is much flatter than printed
+                            // key art; push the colour so each cartridge still
+                            // reads as a different background.
+                            boost(&mut rgba);
+                        }
+                        if res_tx.send((key, rgba)).is_err() {
+                            return;
+                        }
+                    }
+                }
+            })
+            .ok();
+        std::sync::Mutex::new((job_tx, res_rx))
+    })
+    .lock()
+    .unwrap_or_else(|poisoned| poisoned.into_inner())
+}
