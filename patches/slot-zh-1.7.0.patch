+    fn wifi_input(&mut self, action: Action) {
+        let before_ssid = self.wifi.as_ref().map(|page| page.ssid.clone());
+        let command = {
+            let Some(page) = &mut self.wifi else {
+                return;
+            };
+            let key = match action {
+                Action::GbaDown(Btn::Up) => crate::wifi_page::WifiKey::Up,
+                Action::GbaDown(Btn::Down) => crate::wifi_page::WifiKey::Down,
+                Action::GbaDown(Btn::Left) => crate::wifi_page::WifiKey::Left,
+                Action::GbaDown(Btn::Right) => crate::wifi_page::WifiKey::Right,
+                Action::GbaDown(Btn::A) | Action::Insert => crate::wifi_page::WifiKey::A,
+                Action::GbaDown(Btn::B) => crate::wifi_page::WifiKey::B,
+                _ => return,
+            };
+            page.press(key)
+        };
+        let known = self
+            .root()
+            .map(crate::net::known_passwords)
+            .unwrap_or_default();
+        if let Some(page) = &mut self.wifi {
+            if Some(&page.ssid) != before_ssid.as_ref() {
+                page.psk = known
+                    .into_iter()
+                    .find(|(ssid, _)| *ssid == page.ssid)
+                    .map(|(_, psk)| psk)
+                    .unwrap_or_default();
+                page.editing = Some(1);
+                page.dirty = true;
+            }
+        }
+        match command {
+            crate::wifi_page::WifiCommand::None => {}
+            crate::wifi_page::WifiCommand::Close => self.wifi = None,
+            crate::wifi_page::WifiCommand::Connect => self.start_wifi_join(),
+            crate::wifi_page::WifiCommand::Rescan => self.start_wifi_scan(),
+        }
+    }
