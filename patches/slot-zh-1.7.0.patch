+/// Wi-Fi signal glyph: a dot with three arcs, rendered into RGBA.
+/// Returns `(rgba, width, height)`.
+pub fn wifi_face(colour: [u8; 3]) -> (Vec<u8>, u32, u32) {
+    const W: u32 = 28;
+    const H: u32 = 20;
+    const SS: u32 = 4;
+    let cx = W as f32 / 2.0;
+    let cy = H as f32 - 2.5;
+    let mut rgba = vec![0u8; (W * H * 4) as usize];
+    for y in 0..H {
+        for x in 0..W {
+            let mut hits = 0u32;
+            for sy in 0..SS {
+                for sx in 0..SS {
+                    let px = x as f32 + (sx as f32 + 0.5) / SS as f32;
+                    let py = y as f32 + (sy as f32 + 0.5) / SS as f32;
+                    let dx = px - cx;
+                    let dy = py - cy;
+                    if dy > 0.0 {
+                        continue;
+                    }
+                    let r = (dx * dx + dy * dy).sqrt();
+                    if r <= 2.5 {
+                        hits += 1;
+                        continue;
+                    }
+                    let mut lit = false;
+                    for radius in [5.6f32, 9.8, 14.0] {
+                        if (r - radius).abs() <= 1.5 && dx.abs() <= r * 0.82 {
+                            lit = true;
+                            break;
+                        }
+                    }
+                    if lit {
+                        hits += 1;
+                    }
+                }
+            }
+            if hits == 0 {
+                continue;
+            }
+            let cover = hits as f32 / (SS * SS) as f32;
+            let i = ((y * W + x) * 4) as usize;
+            rgba[i] = colour[0];
+            rgba[i + 1] = colour[1];
+            rgba[i + 2] = colour[2];
+            rgba[i + 3] = (cover * 255.0) as u8;
+        }
+    }
+    (rgba, W, H)
+}
