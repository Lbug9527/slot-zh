+/// Sort key for the letter sheet: digits, latin letters, hanzi, everything else.
+fn rank(label: &str) -> u8 {
+    match label.chars().next() {
+        Some(c) if c.is_ascii_digit() => 0,
+        Some(c) if c.is_ascii_alphabetic() => 1,
+        Some(c) if !c.is_ascii() => 2,
+        _ => 3,
+    }
+}
