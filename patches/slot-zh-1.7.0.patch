+/// Translate a user-facing label into Simplified Chinese. Chinese text,
+/// file paths, ROM titles and everything else pass through unchanged.
+pub fn localize(text: &str) -> &str {
+    if !text.is_ascii() {
+        return text;
+    }
+    for (en, zh) in LOCALE_ZHS {
+        if text.eq_ignore_ascii_case(en) {
+            return zh;
+        }
+    }
+    text
+}
