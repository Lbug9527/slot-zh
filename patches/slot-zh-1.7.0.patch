+/// Fonts found on the card: the built-in pixel face plus every TTF/OTF dropped
+/// into ``System/Fonts``. Names are leaked once because the menu needs
+/// ``&'static str`` labels.
+pub fn scan_fonts(root: &std::path::Path) -> Vec<(&'static str, Option<std::path::PathBuf>)> {
+    let mut out: Vec<(&'static str, Option<std::path::PathBuf>)> =
+        vec![("\u{50cf}\u{7d20}\u{ff08}\u{5185}\u{7f6e}\u{ff09}", None)];
+    let Ok(dir) = std::fs::read_dir(root.join("System").join("Fonts")) else {
+        return out;
+    };
+    let mut files: Vec<std::path::PathBuf> = dir
+        .flatten()
+        .map(|entry| entry.path())
+        .filter(|path| {
+            matches!(
+                path.extension().and_then(|e| e.to_str()).map(|e| e.to_ascii_lowercase()).as_deref(),
+                Some("ttf") | Some("otf")
+            )
+        })
+        .collect();
+    files.sort();
+    for path in files {
+        let name = path
+            .file_stem()
+            .and_then(|stem| stem.to_str())
+            .unwrap_or("\u{5b57}\u{4f53}");
+        out.push((Box::leak(name.to_string().into_boxed_str()), Some(path)));
+    }
+    out
+}
