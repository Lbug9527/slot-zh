+    /// Kick off a libretro-database lookup in a worker thread.
+    fn start_online_cheats(&mut self) {
+        if let Some(root) = self.root() {
+            crate::net::persist_diag(root, "cheats-start");
+        }
+        if self.online_cheats.is_some() {
+            return;
+        }
+        let Some(root) = self.root().map(Path::to_path_buf) else {
+            return;
+        };
+        let Some(cart) = self.selected_cart().cloned() else {
+            return;
+        };
+        if !crate::net::http_tool() {
+            self.hud.toast(Toast::CheatsFailed, self.now());
+            return;
+        }
+        let core = self.core;
+        self.hud.toast(Toast::CheatsDownloading, self.now());
+        self.online_cart = Some(cart.stem.clone());
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = std::thread::Builder::new()
+            .name("slot-cheats".to_string())
+            .spawn(move || {
+                let result = crate::online::fetch_for_cart(&root, &cart, core).and_then(|path| {
+                    crate::cheats::CheatSet::load(&root, &cart, core)
+                        .ok_or_else(|| format!("下载的文件无法解析: {}", path.display()))
+                });
+                let _ = tx.send(result);
+            });
+        self.online_cheats = Some(rx);
+    }
+
+    /// Called once per frame; opens the panel when a lookup finishes.
+    pub fn poll_online_cheats(&mut self) {
+        let Some(rx) = &self.online_cheats else {
+            return;
+        };
+        match rx.try_recv() {
+            Ok(Ok(set)) => {
+                eprintln!(
+                    "slot: cheats: online {} entries in {}",
+                    set.cheats.len(),
+                    set.path.display()
+                );
+                if self.online_explicit {
+                    if let Some(page) = &mut self.online_page {
+                        page.mark_ready(set);
+                    } else {
+                        self.cheats = Some(crate::cheat_panel::CheatPanel::new(set));
+                    }
+                } else {
+                    self.cheats = Some(crate::cheat_panel::CheatPanel::new(set));
+                    self.hud.toast(Toast::CheatsDownloaded, self.now());
+                }
+                self.online_explicit = false;
+                self.online_cheats = None;
+            }
+            Ok(Err(why)) => {
+                eprintln!("slot: cheats: online: {why}");
+                if self.online_explicit {
+                    if let Some(root) = self.root() {
+                        crate::net::persist_diag(root, "cheats");
+                    }
+                    let ready = crate::net::online_ready();
+                    let mut detail = vec![why.clone()];
+                    detail.extend(
+                        crate::net::diagnose()
+                            .into_iter()
+                            .filter(|l| !l.starts_with("时钟"))
+                            .take(3),
+                    );
+                    let status = if ready {
+                        "没找到这个游戏的金手指"
+                    } else {
+                        "未连接网络：先到「网络」里连 Wi-Fi"
+                    };
+                    if let Some(page) = &mut self.online_page {
+                        page.set_status(status, detail);
+                    }
+                    self.online_explicit = false;
+                } else {
+                    self.hud.toast(Toast::CheatsFailed, self.now());
+                }
+                self.online_cheats = None;
+            }
+            Err(std::sync::mpsc::TryRecvError::Empty) => {}
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => {
+                self.online_cheats = None;
+            }
+        }
+    }
