+
+/// Selected face used by every label drawn through this module. A chosen
+/// font is leaked once per switch: the setting only changes on a deliberate
+/// menu action, so this cannot grow without bound in practice.
+static OVERRIDE: Mutex<Option<&'static Font>> = Mutex::new(None);
+
+/// Install a user font (TTF/OTF bytes). Returns false when the face cannot be
+/// parsed, in which case the previous font stays in place.
+pub fn set_font(bytes: Vec<u8>) -> bool {
+    let Ok(font) = Font::from_bytes(bytes, FontSettings::default()) else {
+        return false;
+    };
+    let leaked: &'static Font = Box::leak(Box::new(font));
+    if let Ok(mut pick) = OVERRIDE.lock() {
+        *pick = Some(leaked);
+        return true;
+    }
+    false
+}
