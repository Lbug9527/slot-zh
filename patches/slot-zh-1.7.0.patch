+    fn push_wifi_glyph(&self, x0: f32, y0: f32, ink: [f32; 4], out: &mut Vec<Draw>) {
+        const W: i32 = 28;
+        const H: i32 = 20;
+        let cx = 14.0f32;
+        let cy = 17.5f32;
+        for y in 0..H {
+            for x in 0..W {
+                let mut hits = 0;
+                for sy in 0..2 {
+                    for sx in 0..2 {
+                        let px = x as f32 + (sx as f32 + 0.5) / 2.0;
+                        let py = y as f32 + (sy as f32 + 0.5) / 2.0;
+                        let dx = px - cx;
+                        let dy = py - cy;
+                        if dy > 0.0 {
+                            continue;
+                        }
+                        let r = (dx * dx + dy * dy).sqrt();
+                        if r <= 2.5 {
+                            hits += 1;
+                            continue;
+                        }
+                        for radius in [5.6f32, 9.8, 14.0] {
+                            if (r - radius).abs() <= 1.5 && dx.abs() <= r * 0.82 {
+                                hits += 1;
+                                break;
+                            }
+                        }
+                    }
+                }
+                if hits < 2 {
+                    continue;
+                }
+                let mut colour = ink;
+                colour[3] = ink[3] * (hits as f32 / 4.0);
+                out.push(Draw::Rect {
+                    x: x0 + x as f32,
+                    y: y0 + y as f32,
+                    w: 1.0,
+                    h: 1.0,
+                    colour,
+                });
+            }
+        }
+    }
