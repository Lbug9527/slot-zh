+/// Renders the cartridge face and cover-crops it into an OUT_W×OUT_H field.
+/// Used when a game has no cover art anywhere, so the shelf background still
+/// changes per cartridge instead of falling back to the plain wallpaper.
+fn face_backdrop(cart: &slot_store::Cart) -> Vec<u8> {
+    let mut out = vec![0u8; OUT_W as usize * OUT_H as usize * 4];
+    for px in out.chunks_exact_mut(4) {
+        px.copy_from_slice(&[0x18, 0x16, 0x14, 0xff]);
+    }
+    let face = slot_ui::cart_face(cart);
+    if face.w == 0 || face.h == 0 {
+        return out;
+    }
+    let (fw, fh) = (face.w as f32, face.h as f32);
+    let target = OUT_W as f32 / OUT_H as f32;
+    let (crop_w, crop_h) = if fw / fh > target {
+        (fh * target, fh)
+    } else {
+        (fw, fw / target)
+    };
+    let off_x = (fw - crop_w) * 0.5;
+    let off_y = (fh - crop_h) * 0.5;
+    for y in 0..OUT_H {
+        for x in 0..OUT_W {
+            let u = off_x + (x as f32 + 0.5) / OUT_W as f32 * crop_w;
+            let v = off_y + (y as f32 + 0.5) / OUT_H as f32 * crop_h;
+            let sx = (u as u32).min(face.w - 1);
+            let sy = (v as u32).min(face.h - 1);
+            let src = ((sy * face.w + sx) * 4) as usize;
+            let dst = ((y * OUT_W + x) * 4) as usize;
+            let a = face.rgba[src + 3] as f32 / 255.0;
+            for c in 0..3 {
+                let over = face.rgba[src + c] as f32 * a + out[dst + c] as f32 * (1.0 - a);
+                out[dst + c] = over.clamp(0.0, 255.0) as u8;
+            }
+        }
+    }
+    out
+}
+
+/// Pushes saturation and contrast of a backdrop so a blurred cartridge face
+/// still reads as a distinct background.
+fn boost(rgba: &mut [u8]) {
+    for px in rgba.chunks_exact_mut(4) {
+        let (r, g, b) = (px[0] as f32, px[1] as f32, px[2] as f32);
+        let luma = 0.299 * r + 0.587 * g + 0.114 * b;
+        for (i, value) in [r, g, b].into_iter().enumerate() {
+            let boosted = luma + (value - luma) * 1.7;
+            let contrasted = (boosted - 128.0) * 1.12 + 128.0;
+            px[i] = contrasted.clamp(0.0, 255.0) as u8;
+        }
+    }
+}
+
+fn paint_backdrop(
+    app: &mut App,
+    compositor: &mut Compositor,
+    state: &mut CartBgSync,
+    rgba: &[u8],
+) {
+    if rgba.len() < OUT_W as usize * OUT_H as usize * 4 {
+        return;
+    }
+    let idx = 1 - state.cur;
+    let tex = match state.slots[idx] {
+        Some(id) => {
+            compositor.update_texture(id, OUT_W, OUT_H, rgba);
+            id
+        }
+        None => {
+            let id = compositor.create_texture(OUT_W, OUT_H, rgba);
+            state.slots[idx] = Some(id);
+            id
+        }
+    };
+    let prev = state.slots[state.cur];
+    state.cur = idx;
+    app.set_cart_backdrop(Some(tex), prev, Some(CART_BG_FADE_MS));
+}
