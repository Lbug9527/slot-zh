+        let Some((_, path)) = self.fonts.get(self.font_pick) else {
+            return;
+        };
+        match path {
+            None => slot_ui::text::use_builtin_font(),
+            Some(path) => match std::fs::read(path) {
+                Ok(bytes) => {
+                    if !slot_ui::text::set_font(bytes) {
+                        eprintln!("slot: font: {} is not a usable TTF/OTF", path.display());
+                        slot_ui::text::use_builtin_font();
+                    } else {
+                        eprintln!("slot: font: {}", path.display());
+                    }
+                }
+                Err(err) => {
+                    eprintln!("slot: font: {}: {err}", path.display());
+                    slot_ui::text::use_builtin_font();
+                }
+            },
+        }
+    }
