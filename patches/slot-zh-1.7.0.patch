+fn blur_face(rgba: &[u8]) -> Vec<u8> {
+    let (w, h) = (OUT_W as usize, OUT_H as usize);
+    let buf: Vec<[u8; 4]> = rgba
+        .chunks_exact(4)
+        .take(w * h)
+        .map(|c| [c[0], c[1], c[2], c[3]])
+        .collect();
+    if buf.len() < w * h {
+        return rgba.to_vec();
+    }
+    // Blur a half-resolution copy and scale back up: the result is a blurred
+    // backdrop either way, and this is four times less work per switch.
+    let (hw, hh) = ((w / 2).max(1), (h / 2).max(1));
+    let mut small = vec![[0u8, 0, 0, 0]; hw * hh];
+    for y in 0..hh {
+        for x in 0..hw {
+            let (mut acc, mut n) = ([0u32; 3], 0u32);
+            for dy in 0..2 {
+                for dx in 0..2 {
+                    let sx = (x * 2 + dx).min(w - 1);
+                    let sy = (y * 2 + dy).min(h - 1);
+                    let px = &buf[sy * w + sx];
+                    acc[0] += px[0] as u32;
+                    acc[1] += px[1] as u32;
+                    acc[2] += px[2] as u32;
+                    n += 1;
+                }
+            }
+            let n = n.max(1);
+            small[y * hw + x] = [(acc[0] / n) as u8, (acc[1] / n) as u8, (acc[2] / n) as u8, 255];
+        }
+    }
+    let mut tmp = vec![[0u8, 0, 0, 0]; hw * hh];
+    let radius = (hh / 12).max(3) as isize;
+    for _ in 0..3 {
+        blur_rows(&small, &mut tmp, hw, hh, radius);
+        blur_cols(&tmp, &mut small, hw, hh, radius);
+    }
+    let mut out = Vec::with_capacity(w * h * 4);
+    for y in 0..h {
+        let sy = y * hh / h;
+        for x in 0..w {
+            let sx = x * hw / w;
+            let px = small[sy * hw + sx];
+            out.extend_from_slice(&px);
+        }
+    }
+    out
+}
+
+fn blur_rows(src: &[[u8; 4]], dst: &mut [[u8; 4]], w: usize, h: usize, r: isize) {
+    let r = r.max(0) as usize;
+    for y in 0..h {
+        let row = &src[y * w..(y + 1) * w];
+        let mut acc = [0u32; 3];
+        let mut n = 0usize;
+        for px in row.iter().take((r + 1).min(w)) {
+            acc[0] += px[0] as u32;
+            acc[1] += px[1] as u32;
+            acc[2] += px[2] as u32;
+            n += 1;
+        }
+        for x in 0..w {
+            if x > 0 {
+                if x > r {
+                    let px = row[x - 1 - r];
+                    acc[0] -= px[0] as u32;
+                    acc[1] -= px[1] as u32;
+                    acc[2] -= px[2] as u32;
+                    n -= 1;
+                }
+                let add = x + r;
+                if add < w {
+                    let px = row[add];
+                    acc[0] += px[0] as u32;
+                    acc[1] += px[1] as u32;
+                    acc[2] += px[2] as u32;
+                    n += 1;
+                }
+            }
+            let out = &mut dst[y * w + x];
+            let n = n.max(1) as u32;
+            out[0] = (acc[0] / n) as u8;
+            out[1] = (acc[1] / n) as u8;
+            out[2] = (acc[2] / n) as u8;
+            out[3] = 255;
+        }
+    }
+}
+
+fn blur_cols(src: &[[u8; 4]], dst: &mut [[u8; 4]], w: usize, h: usize, r: isize) {
+    let r = r.max(0) as usize;
+    for x in 0..w {
+        let mut acc = [0u32; 3];
+        let mut n = 0usize;
+        for y in 0..(r + 1).min(h) {
+            let px = &src[y * w + x];
+            acc[0] += px[0] as u32;
+            acc[1] += px[1] as u32;
+            acc[2] += px[2] as u32;
+            n += 1;
+        }
+        for y in 0..h {
+            if y > 0 {
+                if y > r {
+                    let px = &src[(y - 1 - r) * w + x];
+                    acc[0] -= px[0] as u32;
+                    acc[1] -= px[1] as u32;
+                    acc[2] -= px[2] as u32;
+                    n -= 1;
+                }
+                let add = y + r;
+                if add < h {
+                    let px = &src[add * w + x];
+                    acc[0] += px[0] as u32;
+                    acc[1] += px[1] as u32;
+                    acc[2] += px[2] as u32;
+                    n += 1;
+                }
+            }
+            let out = &mut dst[y * w + x];
+            let n = n.max(1) as u32;
+            out[0] = (acc[0] / n) as u8;
+            out[1] = (acc[1] / n) as u8;
+            out[2] = (acc[2] / n) as u8;
+            out[3] = 255;
+        }
+    }
 }
 
